{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Setup: 克隆后初始化项目",
            "detail": "创建 .env 和 .venv、生成密钥，并安装运行与开发依赖",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}\\scripts\\setup.ps1"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true,
                "clear": true
            }
        },
        {
            "label": "FastAPI: 启动开发服务",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": ["-m", "uvicorn", "app.main:app", "--reload"],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "focus": true
            }
        },
        {
            "label": "Test: 运行普通测试",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": ["-m", "pytest"],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Test: 运行 MySQL 集成测试",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": ["-m", "pytest", "-m", "integration"],
            "options": {
                "env": {
                    "RUN_MYSQL_TESTS": "1"
                }
            },
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Quality: Ruff 检查",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": ["-m", "ruff", "check", "."],
            "problemMatcher": []
        },
        {
            "label": "Quality: Ruff 格式检查",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": ["-m", "ruff", "format", "--check", "."],
            "problemMatcher": []
        },
        {
            "label": "Quality: MyPy 类型检查",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": ["-m", "mypy", "app"],
            "problemMatcher": []
        },
        {
            "label": "Quality: 完整检查",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Quality: Ruff 检查",
                "Quality: Ruff 格式检查",
                "Quality: MyPy 类型检查",
                "Test: 运行普通测试"
            ],
            "problemMatcher": []
        },
        {
            "label": "Alembic: 生成迁移",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": [
                "-m",
                "alembic",
                "revision",
                "--autogenerate",
                "-m",
                "${input:migrationMessage}"
            ],
            "problemMatcher": []
        },
        {
            "label": "Alembic: 升级到 head",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": ["-m", "alembic", "upgrade", "head"],
            "problemMatcher": []
        },
        {
            "label": "Dependencies: 生成 freeze 快照",
            "type": "process",
            "command": "${command:python.interpreterPath}",
            "args": ["scripts/freeze_requirements.py"],
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "migrationMessage",
            "type": "promptString",
            "description": "请输入 Alembic 迁移说明",
            "default": "describe schema change"
        }
    ]
}
