# Linux 生产环境配置模板。复制为 .env.production 或 .env 后填写真实值，禁止提交真实配置。
APP_PROJECT_NAME="TaskFlow"
APP_PROJECT_VERSION="1.0.0"

# 生产环境必须关闭调试和 SQL 输出，避免接口响应及日志泄露内部信息。
APP_DEBUG=false
APP_DATABASE_ECHO=false
APP_API_V1_PREFIX="/api/v1"

# 替换用户名、密码、主机和数据库名；MySQL 仍然使用异步 aiomysql 驱动。
APP_DATABASE_URL="mysql+aiomysql://taskflow_user:change-me@mysql-host:3306/taskflow?charset=utf8mb4"

# 必须替换为至少 32 字节的随机字符串，例如使用：openssl rand -hex 32
APP_SECRET_KEY="replace-with-a-random-production-secret"
APP_JWT_ALGORITHM="HS256"
APP_ACCESS_TOKEN_EXPIRE_MINUTES=30

# 日志默认输出到控制台，适合由 systemd 或容器平台统一收集。
APP_LOG_LEVEL="INFO"
APP_LOG_FILE=""

# 前端由 FastAPI 同域托管时无需跨域；如有独立前端域名，请替换为真实 HTTPS 地址。
APP_CORS_ORIGINS='["https://your-domain.example"]'
 