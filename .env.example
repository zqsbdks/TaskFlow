# 项目显示名称，会出现在 FastAPI 自动生成的 OpenAPI 文档标题和应用日志中。
APP_PROJECT_NAME="TaskFlow"

# 当前应用发布版本，会显示在 FastAPI 的 Swagger 和 OpenAPI 文档中。
APP_PROJECT_VERSION="1.0.0"

# 是否开启调试模式；本地开发可设为 true，生产环境必须设为 false，避免泄露异常细节。
APP_DEBUG=true

# 所有业务接口共用的 URL 版本前缀，例如用户接口最终可能为 /api/v1/users。
APP_API_V1_PREFIX="/api/v1"

# SQLAlchemy 异步数据库连接地址，依次包含用户名、密码、主机、端口和数据库名；MySQL 驱动必须使用 aiomysql。
APP_DATABASE_URL="mysql+aiomysql://username:password@localhost:3306/dbname?charset=utf8mb4"

# 是否把 SQLAlchemy 执行的 SQL 输出到日志；排查查询问题时可开启，生产环境通常关闭。
APP_DATABASE_ECHO=false

# 应用最低日志级别，可使用 DEBUG、INFO、WARNING、ERROR 或 CRITICAL。
APP_LOG_LEVEL="INFO"

# 日志文件保存路径；留空表示只输出到控制台，填写路径后会同时启用轮转文件日志。
APP_LOG_FILE=""

# JWT 签名密钥，用于防止访问令牌被伪造；生产环境必须使用独立且足够长的随机字符串。
APP_SECRET_KEY="dev-only-change-me-before-production"

# JWT 签名算法；当前代码默认使用对称签名算法 HS256，签发端和验证端必须保持一致。
APP_JWT_ALGORITHM="HS256"

# 访问令牌有效时间，单位为分钟；超过该时间后客户端必须重新登录或刷新令牌。
APP_ACCESS_TOKEN_EXPIRE_MINUTES=30

# 允许跨域访问 API 的前端来源 JSON 数组；生产环境应填写确切域名，不建议保留通配符 "*"。
APP_CORS_ORIGINS='["*"]'
